\f0\fs24 \cf0 name: Build Windows Executable\
\
on: [push, workflow_dispatch]\
\
jobs:\
  build:\
    runs-on: ubuntu-latest\
    steps:\
      - name: Checkout code\
        uses: actions/checkout@v3\
\
      - name: Install MinGW\
        run: sudo apt-get update && sudo apt-get install -y gcc-mingw-w64-i686 g++-mingw-w64-i686\
\
      - name: Build Resource and Executable\
        run: |\
          i686-w64-mingw32-windres resource.rc -o resource.o\
          i686-w64-mingw32-g++ main.cpp resource.o -o RaiseABenny.exe -mwindows -lole32 -loleaut32 -lshlwapi -static-libgcc -static-libstdc++\
\
      - name: Upload Executable\
        uses: actions/upload-artifact@v3\
        with:\
          name: RaiseABenny-exe\
          path: RaiseABenny.exe}
